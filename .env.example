# 复制成 .env 后填入真实值：cp .env.example .env
# .env 必须加入 .gitignore，绝不提交到 git

# ---- 数据库 ----
DB_PASSWORD=change_me_strong_password
DB_NAME=power
DB_USER=power

# ---- EMQX 控制台密码（浏览器访问 http://服务器IP:18083）----
EMQX_PASSWORD=change_me_emqx_password

# ---- LLM 成因诊断 ----
# 留空时：异常区间标注仍然可用（纯本地计算），只是「分析成因」按钮会被禁用。
# 填写后：可在看板上手动触发 LLM 分析。注意这是收费接口，所以设计成手动确认才调用。
# 安全提醒：这个 key 只应存在于服务器本地的 .env 里，绝不提交、绝不贴到聊天里。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 采集参数 ----
MQTT_TOPIC_PREFIX=power/breaker
BATCH_SIZE=500
BATCH_FLUSH_SECONDS=2.0

# ---- 异常检测参数（Day 3 调参时改这里，不用改代码）----
DETECT_WINDOW=60
DETECT_MAD_K=4.0
DETECT_MIN_CONFIRM=2
# 绝对安全阈值：与设备容量无关
LEAKAGE_LIMIT_MA=30.0
VOLTAGE_MIN_V=198.0
TEMP_LIMIT_C=55.0
# 相对电气阈值：过载预警起点 = THERMAL_HOLD_FACTOR x 该设备额定电流
# 1.13 是 IEC 60898-1 热保护保持边界，低于此值 1 小时内本不应脱扣
THERMAL_HOLD_FACTOR=1.13
# 默认额定电流（实际检测时按每台设备的档位覆盖）
RATED_CURRENT_A=20.0
