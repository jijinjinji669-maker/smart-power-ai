# 复制成 .env 后填入真实值：cp .env.example .env
# .env 必须加入 .gitignore，绝不提交到 git

# ---- 数据库 ----
DB_PASSWORD=change_me_strong_password
DB_NAME=power
DB_USER=power

# ---- EMQX 控制台密码（浏览器访问 http://服务器IP:18083）----
EMQX_PASSWORD=change_me_emqx_password

# ---- LLM（Phase 6 用；没有钥匙就先留空，项目其余部分照常运行）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 采集参数 ----
MQTT_TOPIC_PREFIX=power/breaker
BATCH_SIZE=500
BATCH_FLUSH_SECONDS=2.0

# ---- 异常检测参数（Day 3 调参时改这里，不用改代码）----
DETECT_WINDOW=60
DETECT_MAD_K=4.0
DETECT_MIN_CONFIRM=2
LEAKAGE_LIMIT_MA=30.0
VOLTAGE_MIN_V=198.0
TEMP_LIMIT_C=55.0
